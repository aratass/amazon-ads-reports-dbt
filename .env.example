# Copy to .env (git-ignored) and fill in. The client secret and refresh token are secrets:
# keep them in a secret manager in production, never in the repository.

# --- Amazon Ads API (the client's approved API application) ---
AMAZON_ADS_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
AMAZON_ADS_CLIENT_SECRET=
# Refresh token from the Login with Amazon authorization grant, scope advertising::campaign_management
AMAZON_ADS_REFRESH_TOKEN=
# Regions to read: NA, EU, FE (comma-separated)
AMAZON_ADS_REGIONS=NA
# Optional: only these profiles (comma-separated). Default: every seller and vendor profile.
AMAZON_ADS_PROFILE_IDS=

# --- Pipeline ---
WAREHOUSE=bigquery
BQ_PROJECT=
BQ_LOCATION=US
BQ_RAW_DATASET=amazon_ads_raw

# --- dbt (transform/profiles.yml) ---
DBT_TARGET=prod
BQ_DATASET=amazon_ads
